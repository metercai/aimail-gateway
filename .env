# =============================================================================
# amail-gateway — Deployment Env Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments, others are sourced by deploy.sh.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   bash deploy.sh upload
# =============================================================================

# ── SSH Connection ───────────────────────────────────────────────────────────
# Target cloud host IP or domain (REQUIRED)
AMAIL_DEPLOY_HOST="46.17.41.218"

# SSH port (default: 22)
# AMAIL_DEPLOY_PORT="22"

# SSH user (default: root)
# AMAIL_DEPLOY_USER="root"

# SSH private key path for password-less authentication (default: detects ~/.ssh/id_deploy)
# AMAIL_DEPLOY_KEY="$HOME/.ssh/id_deploy"
