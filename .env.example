# =============================================================================
# aimail-gateway — Deployment Env Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   bash deploy.sh upload
# =============================================================================

# ── SSH Connection ───────────────────────────────────────────────────────────
# Target cloud host IP or domain (REQUIRED)
# AIMAIL_DEPLOY_HOST="your.cloud.host"

# SSH port (default: 22)
# AIMAIL_DEPLOY_PORT="22"

# SSH user (default: root)
# AIMAIL_DEPLOY_USER="root"

# SSH private key path for password-less authentication (default: detects ~/.ssh/id_deploy)
# AIMAIL_DEPLOY_KEY="$HOME/.ssh/id_deploy"
